{
  "name": "studies",
  "productName": "Universal Learn Academy",
  "version": "2.7.0",
  "description": "Universal Learn Academy : cours, quiz et TD interactifs, catalogue à la demande, profils et cursus.",
  "author": "WolfGang-PRoxa",
  "license": "CC-BY-NC-ND-4.0",
  "private": true,
  "main": "src/main.js",
  "homepage": "https://github.com/WolfGang-PRoxa/universal-learn-academy",
  "repository": {
    "type": "git",
    "url": "https://github.com/WolfGang-PRoxa/universal-learn-academy.git"
  },
  "scripts": {
    "start": "electron .",
    "format": "prettier --write --ignore-path ../.prettierignore . ../_outils",
    "lint": "eslint . ../_outils",
    "check": "prettier --check --ignore-path ../.prettierignore . ../_outils && eslint . ../_outils && node scripts/check.mjs",
    "test": "node --test",
    "contenu": "node scripts/preparer-contenu.mjs",
    "donnees-perso": "node scripts/check.mjs --lister-personnels",
    "dist": "node scripts/construire.mjs",
    "release": "node scripts/release.mjs",
    "public": "node scripts/exporter-public.mjs",
    "catalogue": "node scripts/catalogue.mjs",
    "accepter-proposition": "node scripts/accepter-proposition.mjs"
  },
  "desktopName": "universal-learn-academy.desktop",
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "fr.wolfgangproxa.studies",
    "productName": "Universal Learn Academy",
    "copyright": "Copyright © 2026 WolfGang-PRoxa",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@electric-sql/pglite/**"
    ],
    "extraResources": [
      {
        "from": ".outils",
        "to": "outils",
        "filter": [
          "**/*"
        ]
      }
    ],
    "afterPack": "scripts/apres-empaquetage.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Universal-Learn-Academy-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Universal Learn Academy"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "syncDesktopName": true,
      "artifactName": "Universal-Learn-Academy-${version}.${ext}",
      "synopsis": "Cours, quiz et TD interactifs, catalogue à la demande",
      "executableName": "universal-learn-academy"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WolfGang-PRoxa",
        "repo": "universal-learn-academy",
        "releaseType": "release"
      }
    ]
  }
}
