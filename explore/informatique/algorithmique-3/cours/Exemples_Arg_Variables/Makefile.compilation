#
# Option compilation 
#

 CCOBJ=gcc -c
 CCLNK=gcc 

# Valeurs possibles : yes , no  
DEBUG=yes
# Valeurs possibles : apple , linux 
ARCH=apple

ifeq ($(DEBUG),yes)
	 FLAGS=-Wall -g -D_DEBUG_
else
	 FLAGS=-Wall 
endif


ifeq ($(ARCH),apple)
	CFLAGS= $(FLAGS) -D_APPLE_
endif

ifeq ($(ARCH),linux)
	LIBMATH=-lm
	CFLAGS= $(FLAGS) -D_LINUX_
endif
