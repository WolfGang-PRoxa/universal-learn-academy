#
# Dependances INTER-DOSSIERS
#
# Regle du jeu : un Makefile ne compile que les fichiers de SON dossier.
# Quand il a besoin d'un .o qui vit ailleurs, il ne le compile pas lui-meme :
# il redescend dans le dossier proprietaire et lui demande de le faire.
# C'est ca, la cascade.
#
# Aucune pour l'instant : pas encore de sous-dossier.
# Modele, le jour ou un dossier Emetteur fournira emetteur.o :
#
# $(build_dir)/emetteur.o : $(emetteur_dir)/emetteur.c $(emetteur_dir)/emetteur.h
#	$(MAKE) -C $(emetteur_dir) emetteur.o
#
